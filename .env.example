# Supabase project settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by the Supabase Edge Function (supabase/functions/nightly-backup).
# Set these as Supabase Edge Function secrets, NOT in this file / not with a VITE_ prefix,
# so they never ship to the browser bundle. See README.md "Backups" for setup.
# SUPABASE_SERVICE_ROLE_KEY=
# BACKUP_S3_ENDPOINT=       # e.g. https://<accountid>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto
